# ---------------------------------------------------------------------------
# Invictus CRM - environment (INV-6)
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# ---------------------------------------------------------------------------

# --- Supabase Postgres -------------------------------------------------------
# DATABASE_URL is the POOLED connection (Transaction pooler, port 6543) used by
# the running app. It must be the pooler on Vercel: Vercel is IPv4-only and the
# direct host db.<ref>.supabase.co resolves IPv6-only.
#
# Pool settings (INV-49): connection_limit=5, pool_timeout=20. The Free plan
# runs on Nano compute, whose pooler accepts at most 200 client connections;
# every Prisma client (each dev server, each warm Vercel instance) opens up to
# connection_limit of them. 5 lets one dashboard render run its parallel
# queries without queueing, and still leaves room for ~35 Vercel instances
# beside five local dev servers. connection_limit=1 serialised every query and
# produced P2024 pool timeouts. pool_timeout=20 (Prisma default 10) absorbs dev
# compile stalls but stays finite so real exhaustion still surfaces.
#
# DIRECT_URL is the SESSION pooler - same host, port 5432, no pgbouncer
# params - used only by the Prisma CLI (`prisma migrate`, via
# prisma.config.ts). Migrations cannot run through the transaction pooler, and
# the direct host db.<ref>.supabase.co is IPv6-only (CLAUDE.md section 8).
#
# Both are on the Supabase dashboard under Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Supabase API ------------------------------------------------------------
# New-format API keys (sb_publishable_ / sb_secret_), which replace the legacy
# anon / service_role JWTs. Dashboard -> Project Settings -> API keys.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Used by the seed script to create the seeded login user.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# Asymmetric JWT verification endpoint. Recorded for completeness - the app
# verifies sessions through supabase.auth.getUser() rather than validating JWTs
# locally, so nothing reads this yet.
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# --- Webhooks (INV-60) --------------------------------------------------------
# Bearer token the scan-ingest endpoint (app/api/webhooks/scan) expects on
# every request, as `Authorization: Bearer <value>`. Machine-to-machine only -
# not a Supabase session. Generate with e.g. `openssl rand -hex 32`.
SCAN_WEBHOOK_SECRET="replace-with-a-long-random-value"

# Same scheme for the inbound-signup endpoint (app/api/webhooks/signup, INV-62).
# A separate value from the scan secret, so one can be rotated without the other.
SIGNUP_WEBHOOK_SECRET="replace-with-a-long-random-value"
